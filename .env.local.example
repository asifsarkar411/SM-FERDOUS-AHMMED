# ==========================================
# Pritom Chowdhury Portfolio Environment Configuration
# ==========================================

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/pritom_portfolio?retryWrites=true&w=majority"

# NextAuth.js Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-random-32-character-key"
NEXTAUTH_URL="http://localhost:3000"

# Default Admin Credentials for /admin Dashboard
# (You can also seed these into MongoDB using `npm run seed`)
ADMIN_EMAIL="admin@pritom.dev"
ADMIN_PASSWORD="Admin@123456"
